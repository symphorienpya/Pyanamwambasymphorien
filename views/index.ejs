<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f6f5f0">
    <meta name="description" content="The portfolio of Symphorien Pyana — web developer and graphic designer at Agromwinga.">
    <title>Symphorien Pyana — Digital craft, with intention.</title>
    <script>
      try {
        if (localStorage.getItem('portfolio-theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
    <link rel="icon" type="image/jpeg" href="/pyana.jpeg">
    <link rel="apple-touch-icon" href="/pyana.jpeg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <script defer src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script defer src="/app.js"></script>
  </head>
  <body data-supabase-url="<%= supabaseUrl %>" data-supabase-key="<%= supabaseAnonKey %>">
    <div class="scroll-progress" aria-hidden="true"><span id="scroll-progress-bar"></span></div>
    <header class="topbar">
      <a class="wordmark" href="#home" aria-label="Symphorien Pyana, back to top"><img src="/pyana.jpeg" alt=""><span class="wordmark-label">SYMPHORIEN<br>PYANA</span></a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#about">Profile</a>
        <a href="#collaborations">Collaborations</a>
        <a href="#contact">Contact</a>
      </nav>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch to dark theme" aria-pressed="false">
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path></svg>
      </button>
      <a class="availability" href="https://wa.me/243839669971" target="_blank" rel="noopener noreferrer" aria-label="Chat with me on WhatsApp" title="Chat on WhatsApp">
        <img src="https://cdn.simpleicons.org/whatsapp/25D366" alt="">
      </a>
    </header>

    <main>
      <section class="hero" id="home">
        <div class="hero-layout page-shell">
          <div class="hero-copy reveal">
            <p class="eyebrow"><span class="eyebrow-rule"></span>Web developer · Graphic designer</p>
            <h1>Symphorien<br><span>Pyana.</span></h1>
            <p class="hero-description">I build thoughtful digital products and visual identities, bringing design and development together from first idea to launch.</p>
            <div class="hero-actions">
              <a class="button button-lime" href="#work">Explore my work <span aria-hidden="true">↘</span></a>
              <a class="text-link" href="mailto:symphorienpyana065@gmail.com">Start a conversation <span aria-hidden="true">↗</span></a>
            </div>
            <div class="hero-meta">
              <span>BASED IN THE DEMOCRATIC REPUBLIC OF THE CONGO</span>
              <span class="live-state" id="live-state"><span class="live-dot"></span><%= portfolio.live ? 'LIVE · SUPABASE CONNECTED' : 'PORTFOLIO · READY' %></span>
            </div>
          </div>
          <figure class="hero-visual reveal">
            <img src="/pyana.jpeg" alt="Portrait of Symphorien Pyana, web developer and graphic designer">
            <figcaption class="visual-caption"><span>IN PRACTICE</span><span>DESIGN · CODE · IDEAS</span></figcaption>
            <span class="hero-image-index" aria-hidden="true">SP / 01</span>
          </figure>
        </div>
        <div class="hero-bottom page-shell"><span>Currently building with Agromwinga</span><span>Available for select collaborations <i></i></span>
          <div class="hero-bottom page-shell"><span>Currently building with Agromwinga</span><span>Available for select collaborations <i></i></span></div>
      </section>

      <section class="work-section page-shell" id="work">
        <div class="section-heading">
          <div><p class="eyebrow"><span class="eyebrow-rule"></span>Selected work · 01—03</p><h2>Built to be <span>useful.</span></h2></div>
          <p class="section-aside">Live products shaped around<br>real people and real needs.</p>
        </div>
        <div class="projects-grid" id="projects-grid">
          <% portfolio.projects.forEach((project, index) => { %>
            <article class="project-card reveal">
              <button class="project-image" type="button" data-project-index="<%= index %>" aria-label="View <%= project.name %> project details">
                <img src="<%= project.image_url %>" alt="<%= project.image_alt || project.name %>" loading="lazy">
                <span class="image-arrow" aria-hidden="true">↗</span>
              </button>
              <div class="project-info">
                <div><p class="project-category"><%= project.category %><% if (project.is_concept !== false) { %> <span>· CONCEPT</span><% } %></p><h3><%= project.name %></h3></div>
                <button class="project-open" type="button" data-project-index="<%= index %>" aria-label="View <%= project.name %> project">↗</button>
              </div>
              <p class="project-summary"><%= project.summary %></p>
              <div class="project-tags"><% (project.technologies || []).forEach((tag) => { %><span><%= tag %></span><% }) %></div>
            </article>
          <% }) %>
        </div>
        <p class="work-note"><span>✳</span> Select a project to explore the live experience.</p>
      </section>

      <section class="intro-band" id="about">
        <div class="section-inner intro-layout">
          <p class="eyebrow"><span class="eyebrow-rule"></span>Profile · 01</p>
          <div class="intro-content">
            <h2>Design with clarity.<br><span>Build with purpose.</span></h2>
            <div class="intro-details">
              <p>I’m a multidisciplinary creative currently working at Agromwinga. I bring visual design and web development together to make digital experiences feel clear, work reliably, and help people move forward.</p>
              <div class="profile-facts">
                <div><span class="fact-label">CURRENTLY</span><strong>Agromwinga</strong></div>
                <div><span class="fact-label">PRACTICE</span><strong>Web · Mobile · Identity</strong></div>
                <div><span class="fact-label">BASED IN</span><strong>DR Congo</strong></div>
                <div><span class="fact-label">APPROACH</span><strong>Clarity · Craft · Purpose</strong></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="practice-section" id="practice">
        <div class="section-inner">
          <div class="section-heading practice-heading">
            <div><p class="eyebrow"><span class="eyebrow-rule"></span>Capabilities · 02</p><h2>One practice,<br><span>many ways to build.</span></h2></div>
            <p class="section-aside">A connected toolkit for<br>digital products and identity.</p>
          </div>
          <div class="skills-row">
            <span class="skills-label">MY TOOLKIT</span>
            <div class="skill-list"><span>JavaScript</span><span>Node.js</span><span>Express</span><span>EJS</span><span>React Native</span><span>Python</span><span>Supabase</span><span>Graphic design</span></div>
          </div>
          <div class="practice-columns">
            <section class="practice-column">
              <div class="column-heading"><span>01</span><h3>Achievements</h3></div>
              <% portfolio.achievements.forEach((achievement) => { %>
                <article class="list-item"><span class="list-marker">✳</span><div><h4><%= achievement.title %></h4><p><%= achievement.description %></p></div></article>
              <% }) %>
            </section>
            <section class="practice-column">
              <div class="column-heading"><span>02</span><h3>In the making</h3></div>
              <% portfolio.upcoming.forEach((project) => { %>
                <article class="list-item"><span class="list-marker">↗</span><div><div class="upcoming-title"><h4><%= project.title %></h4><span class="status-pill"><%= project.status %></span></div><p><%= project.description %></p></div></article>
              <% }) %>
            </section>
          </div>
        </div>
      </section>

      <section class="collab-section page-shell" id="collaborations">
        <div class="section-heading collab-heading">
          <div><p class="eyebrow"><span class="eyebrow-rule"></span>Collaborations · 03</p><h2>Better work,<br><span>made together.</span></h2></div>
          <p class="section-aside">The kinds of collaborations<br>I’m excited to make room for.</p>
        </div>
        <div class="collab-list">
          <% portfolio.collaborations.forEach((collaboration, index) => { %>
            <article class="collab-item"><span class="collab-number">0<%= index + 1 %></span><div><h3><%= collaboration.title %></h3><p><%= collaboration.description %></p></div><span class="collab-type"><%= collaboration.type %></span><span class="collab-arrow" aria-hidden="true">↗</span></article>
          <% }) %>
        </div>
      </section>

      <section class="contact-section" id="contact">
        <div class="section-inner contact-inner">
          <div><p class="eyebrow"><span class="eyebrow-rule"></span>Have something in mind?</p><h2>Let’s make<br><span>it matter.</span></h2></div>
          <div class="contact-details">
            <p>I’m always glad to hear about a thoughtful project, a shared idea, or an opportunity to make something useful.</p>
            <div class="contact-email-row">
              <a class="contact-email" href="mailto:symphorienpyana065@gmail.com">symphorienpyana065@gmail.com <span aria-hidden="true">↗</span></a>
              <button class="copy-email" id="copy-email" type="button" aria-label="Copy email address" title="Copy email address" data-email="symphorienpyana065@gmail.com">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2"></rect><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path></svg>
              </button>
            </div>
            <p class="copy-feedback" id="copy-feedback" role="status" aria-live="polite"></p>
            <div class="contact-links"><a href="https://wa.me/243839669971" target="_blank" rel="noreferrer">WhatsApp <span aria-hidden="true">↗</span></a><a href="tel:+243839669971">+243 839 669 971 <span aria-hidden="true">↗</span></a></div>
            <div class="social-links" role="group" aria-label="Social profiles">
              <a class="social-item" href="https://www.facebook.com/profile.php?id=61596603205934" target="_blank" rel="noopener noreferrer"><img src="https://cdn.simpleicons.org/facebook/1877F2" alt=""><span>Facebook</span><span class="social-arrow" aria-hidden="true">↗</span></a>
              <a class="social-item" href="https://www.linkedin.com/in/symphorien-pyana/" target="_blank" rel="noopener noreferrer"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v13/icons/linkedin.svg" alt=""><span>LinkedIn</span><span class="social-arrow" aria-hidden="true">↗</span></a>
              <a class="social-item" href="https://github.com/symphorienpya" target="_blank" rel="noopener noreferrer"><img src="https://cdn.simpleicons.org/github/FFFFFF" alt=""><span>GitHub</span><span class="social-arrow" aria-hidden="true">↗</span></a>
              <a class="social-item" href="https://www.youtube.com/channel/UCb00oQN22DG4gKQ2NlSldNg" target="_blank" rel="noopener noreferrer"><img src="https://cdn.simpleicons.org/youtube/FF0000" alt=""><span>YouTube</span><span class="social-arrow" aria-hidden="true">↗</span></a>
              <span class="social-item social-pending" title="Instagram profile link not set"><img src="https://cdn.simpleicons.org/instagram/E4405F" alt=""><span>Instagram</span><small>LINK NEEDED</small></span>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer"><a class="wordmark" href="#home" aria-label="Back to top"><img src="/pyana.jpeg" alt=""><span class="wordmark-label">SYMPHORIEN<br>PYANA</span></a><div class="footer-socials"><a class="footer-social" href="https://www.facebook.com/profile.php?id=61596603205934" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><img src="https://cdn.simpleicons.org/facebook/1877F2" alt=""></a><a class="footer-social" href="https://www.linkedin.com/in/symphorien-pyana/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v13/icons/linkedin.svg" alt=""></a><a class="footer-social" href="https://github.com/symphorienpya" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><img src="https://cdn.simpleicons.org/github/181717" alt=""></a><a class="footer-social" href="https://www.youtube.com/channel/UCb00oQN22DG4gKQ2NlSldNg" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><img src="https://cdn.simpleicons.org/youtube/FF0000" alt=""></a><span class="footer-social social-pending" title="Instagram profile link not set" aria-label="Instagram profile link not set"><img src="https://cdn.simpleicons.org/instagram/E4405F" alt=""></span></div><a href="#home">BACK TO TOP ↑</a><span>© <%= new Date().getFullYear() %> SYMPHORIEN PYANA</span></footer>

    <dialog class="project-dialog" id="project-dialog" aria-labelledby="dialog-title">
      <button class="dialog-close" type="button" aria-label="Close project details">×</button>
      <div class="dialog-image"><img id="dialog-image" src="" alt=""></div>
      <div class="dialog-content"><p class="eyebrow"><span class="eyebrow-rule"></span><span id="dialog-category"></span></p><h2 id="dialog-title"></h2><p class="dialog-description" id="dialog-description"></p><div class="project-tags" id="dialog-tags"></div><a class="button button-dark dialog-link" id="dialog-link" href="#" target="_blank" rel="noreferrer">Open live project <span aria-hidden="true">↗</span></a></div>
      <p class="preview-notice">Some project hosts block in-page previews. Use “Open live project” above if the preview does not load.</p>
      <div class="dialog-preview"><iframe id="dialog-preview" title="Live project preview" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
    </dialog>

    <script id="portfolio-data" type="application/json"><%- JSON.stringify(portfolio).replace(/</g, '\\u003c') %></script>
  </body>
</html>